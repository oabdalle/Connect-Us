@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h4>@ViewData["Title"]</h4>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.7.6/dropzone.min.css" integrity="sha512-jU/7UFiaW5UBGODEopEqnbIAHOI8fO6T99m7Tsmqs2gkdujByJfkCbbfPSN4Wlqlb9TGnsuC0YgUgWkRBK7B9A==" crossorigin="anonymous" />
<partial name="_StatusMessage" model="Model.StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="profile-form" enctype = "multipart/form-data" method="post">
             <div class="form-group row">
            <div class="col-3 pl-0">
                <div>
                    <img src="data:image/jpeg;base64,@Model.ProfileViewModel.Content" class="w-100">
                </div>
                <label>Image
                </label>
            </div>
            <div class="col-9">
                <button type="button" id="toggle-dz" class="btn btn-primary ml-2 dz-vis">Replace image</button>
                <div id="dZUpload" class="border border-primary dropzone dz-clickable rounded" style="display: none;">
                    <div class="dz-message">Drop files here or click to upload and rearrange.
                        <br>
            
                    </div>
        
                </div>
                <div id="dz-buttons" style="display: none;">
                    <input  type="file" id="imgs" asp-for="ProfileViewModel.GalleryFiles" />
                    <span asp-validation-for="ProfileViewModel.GalleryFiles" class="text-danger"></span>
                    <button type="button" id="hide-dz" class="btn btn-primary ml-2 float-right dz-vis">Cancel</button>
                </div>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control" disabled />
            </div>
            <div class="form-group">
                <label asp-for="Input.PhoneNumber"></label>
                <input asp-for="Input.PhoneNumber" class="form-control" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <div>
            <button id="update-profile-button" class="btn btn-primary ml-2">Save</button>
            <input hidden type="submit" id="post-form" />
            </div>
        </form>
    </div>
</div>

@* this is client side validation not server side (we have done both) *@
@section Scripts{
<partial name="_ValidationScriptsPartial"/> 
<script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.10.3/jquery-ui.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.7.6/min/dropzone.min.js" integrity="sha512-KgeSi6qqjyihUcmxFn9Cwf8dehAB8FFZyl+2ijFEPyWu4ZM8ZOQ80c2so59rIdkkgsVsuTnlffjfgkiwDThewQ==" crossorigin="anonymous"></script>
 
  <script>
    $(".dz-vis").click(function() {
        $("#dZUpload").toggle();
        $("#dz-buttons").toggle();
        $("#toggle-dz").toggle();
    });

    Dropzone.autoDiscover = false;
   
   $(document).ready(function () {
      $("#dZUpload").sortable({
         items:'.dz-preview',
         cursor: 'move',
         opacity: 0.5,
         containment: '#dZUpload',
         distance: 20,
         tolerance: 'pointer'
     });
     $("#dZUpload").dropzone({
         autoProcessQueue: false,
         url: "/account/manage",
         addRemoveLinks: true,
         maxFiles:1,
       init: function() {
       this.on("maxfilesexceeded", function(file) {
            this.removeAllFiles();
            this.addFile(file);
             });
            dzClosure = this;
             document.getElementById("update-profile-button").addEventListener("click", async function(e) {
             e.preventDefault();
             e.stopPropagation();
             if(await UpdateFiles(dzClosure.files)){           
                 $('#post-form').click();
             }
             
         });
       },
         success: function (file, response) {
         },
         error: function (file, response) {
         }
     });
 });
     async function UpdateFiles(dzFiles){
         newQueue = [];
         var queue = dzFiles;
         await $('#dZUpload .dz-preview .dz-filename [data-dz-name]').each(async function (count, el) {           
             var name = el.innerHTML;
             await queue.forEach(function(file) {
                 if (file.name === name) {
                     newQueue.push(file);
                 }
             });
         });
         dzFiles = newQueue;
         let list = new DataTransfer();
         for (var i = 0; i < dzFiles.length; i++) {
             list.items.add(dzFiles[i])
         }
         let myFileList = list.files;    
         document.getElementById('imgs').files=myFileList;
         console.log(myFileList); 
         return true;
     }
  </script>
   
}  