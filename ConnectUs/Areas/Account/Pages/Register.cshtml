@page
@model RegisterModel
@{
    ViewData["Title"] = "Connect Us";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ConnectUs</title>
    <link rel="stylesheet" href="~/dist/bundle.css" />
    <link rel="icon" type="image/svg" href="~/images/connectus-logo.png" />
</head>
<body>
<div class="bg" style="background-image: url(../images/tvbuyingguide-2x1-lowres.jpg);">
    <div class="log-in">
    <h1 class="text-center text-white with-eight">@ViewData["Title"]</h1>
        <div class="row">
            <div class="col-md-4 mx-auto">
                <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <h4 class="text-center text-white with-eight">Create a new account.</h4>
                    <hr />
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="form-group">
                        <label class="text-white" asp-for="Input.Email"></label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="text-white" asp-for="Input.Password"></label>
                        <input asp-for="Input.Password" class="form-control" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="text-white" asp-for="Input.ConfirmPassword"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label class="text-white">Role</label>
                        <select asp-for="Input.SelectedRole" asp-items="Model.RoleList" class="form-control"></select>
                    </div>
                        <button type="submit" class="btn btn-primary">Register</button>
                        <a asp-area="Account" asp-page="/Login" class="btn btn-primary float-right">Return</a>
                </form>
            </div>

        </div>
    </div>
</div>
</body>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
