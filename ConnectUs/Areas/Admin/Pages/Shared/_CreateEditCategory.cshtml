
@model CreateCategoryViewModel
@Html.AntiForgeryToken()
<div class="row justify-content-end">
<button type="button" class="btn btn-primary mr-5" data-toggle="modal" data-target="#categoryModalCenter">
  Create Category
</button>
</div>
<!-- Modal -->
<div class="modal fade" id="categoryModalCenter" tabindex="-1" role="dialog" aria-labelledby="categoryModalCenterTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="categoryModalLongTitle">Create Category</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      
      <div class="modal-body">
        <div class="form-group row">
          <div class="col-6">
            <label>Current Categories</label>
          </div>
          <div class="col-6">
            <select class="form-control text-center" asp-items="Model.CategoriesDropDownList">
            </select>
          </div>
        </div>
    <form id="createForm" method="post">
        <div class="form-group row">
          <div class="col-6">
            <label asp-for="Category.CategoryName">
            </label>
          </div>
          <div class="col-6">
            <input asp-for="Category.CategoryName" class="form-control"/>
          </div>
          <span asp-validation-for="Category.CategoryName" class="text-danger"></span>
        </div>
    </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        <input onclick="CreateCategory(document.getElementById('Category_CategoryName').value)" class="btn btn-primary" value="Save"> 

      </div>
    
    </div>
  </div>
</div>

<div class="modal fade" id="categoryEditModalCenter" tabindex="-1" role="dialog" aria-labelledby="categoryEditModalCenterTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="categoryEditModalLongTitle">Edit Category</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      
      <div class="modal-body">
        <div class="form-group row">
          <div class="col-6">
            <label>Edit Category</label>
          </div>
          <div class="col-6">
              <input type="text" readonly hidden name="categoryId" id="categoryId" value=""/>
              <input type="text" class="form-control" readonly name="categoryName" id="categoryName" value=""/>
          </div>
        </div>
    <form id="editForm" method="post">
        <div class="form-group row">
          <div class="col-6">
            <label asp-for="Category.CategoryName">
            </label>
          </div>
          <div class="col-6">
            <input asp-for="Category.CategoryName" id="newCategoryName"class="form-control"/>
          </div>
          <span asp-validation-for="Category.CategoryName" class="text-danger"></span>
        </div>
    </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        <input onclick="EditCategory(document.getElementById('categoryId').value, document.getElementById('newCategoryName').value)" class="btn btn-primary" value="Save"> 

      </div>
    
    </div>
  </div>
</div>

