
@model CreateCategoryViewModel
@Html.AntiForgeryToken()
<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#categoryModalCenter">
  Create Category
</button>

<!-- Modal -->
<div class="modal fade" id="categoryModalCenter" tabindex="-1" role="dialog" aria-labelledby="categoryModalCenterTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="categoryModalLongTitle">Create Category</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      
      <div class="modal-body">
        <div class="form-group row">
          <div class="col-6">
            <label>Current Categories</label>
          </div>
          <div class="col-6">
            <select class="form-control text-center" asp-items="Model.CategoriesDropDownList">
            </select>
          </div>
        </div>
    <form id="createForm" method="post">
        <div class="form-group row">
          <div class="col-6">
            <label asp-for="Category.CategoryName">
            </label>
          </div>
          <div class="col-6">
            <input asp-for="Category.CategoryName" class="form-control"/>
          </div>
          <span asp-validation-for="Category.CategoryName" class="text-danger"></span>
        </div>
    </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        <input onclick="CreateCategory(document.getElementById('Category_CategoryName').value)" class="btn btn-primary" value="Save"> 

      </div>
    
    </div>
  </div>
</div>

<div class="modal fade" id="categoryEditModalCenter" tabindex="-1" role="dialog" aria-labelledby="categoryEditModalCenterTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="categoryEditModalLongTitle">Edit Category</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      
      <div class="modal-body">
        <div class="form-group row">
          <div class="col-6">
            <label>Edit Category</label>
          </div>
          <div class="col-6">
              <input type="text" readonly name="categoryId" id="categoryId" value=""/>
              <input type="text" readonly name="categoryName" id="categoryName" value=""/>
          </div>
        </div>
    <form id="editForm" method="post">
        <div class="form-group row">
          <div class="col-6">
            <label asp-for="Category.CategoryName">
            </label>
          </div>
          <div class="col-6">
            <input asp-for="Category.CategoryName" id="newCategoryName"class="form-control"/>
          </div>
          <span asp-validation-for="Category.CategoryName" class="text-danger"></span>
        </div>
    </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        <input onclick="EditCategory(document.getElementById('categoryId').value, document.getElementById('newCategoryName').value)" class="btn btn-primary" value="Save"> 

      </div>
    
    </div>
  </div>
</div>
<script>


function CreateCategory(category){

  if($("#createForm").valid()){
    $.ajax({
          type: "POST",
          url:'/admin/manage-categories?handler=CreateCategory',          
          beforeSend: function (xhr) {
              xhr.setRequestHeader("XSRF-TOKEN",$('input:hidden[name="__RequestVerificationToken"]').val());
          },
          data: {categoryName: category},
          success: function (result) {
              if(result=="Success"){
                sessionStorage.setItem('reloadAfterCreate', "true");
                window.location.reload(true);
              }
          },
          failure: function () {
              alert("fail: ");
          },
          error: function () {
              alert("error: ");
          }
      });
  }
}


function EditCategory(categoryId, categoryName){
  console.log(categoryId)
  console.log(categoryName)
  var category ={
    CategoryId: categoryId,
    CategoryName: categoryName
  }

  if($("#editForm").valid()){
    $.ajax({
          type: "POST",
          contentType: "application/json",
          url:'/admin/manage-categories?handler=EditCategory',          
          beforeSend: function (xhr) {
              xhr.setRequestHeader("XSRF-TOKEN",$('input:hidden[name="__RequestVerificationToken"]').val());
          },
          data: JSON.stringify(category),
          dataType: "json",
          success: function (result) {
              console.log(result)
              if(result=="Success"){
    
                sessionStorage.setItem('reloadAfterEdit', "true"); 
                window.location.reload(true);     
                    
              }
          },
          failure: function () {
              alert("fail: " );
          },
          error: function (xhr, status, error) {
              alert(xhr.responseText);
          }
      });
  }
}

</script>
<script>
window.addEventListener('load', function () {

    $(".edit-category").click(function(){
        var categoryId = $(this).data('id');
        var categoryName = $(this).data('name');
        $("#categoryEditModalCenter #categoryId").val( categoryId );
        $("#categoryEditModalCenter #categoryName").val( categoryName );
    }); 
    
      if (sessionStorage.getItem('reloadAfterEdit')=="true"){
            sessionStorage.setItem('reloadAfterEdit', "false");
            toastr.success("Successful Edit");
      }else if(sessionStorage.getItem('reloadAfterCreate')=="true"){
            sessionStorage.setItem('reloadAfterCreate', "false");
            toastr.success("Successful Create");
      }
})


</script>