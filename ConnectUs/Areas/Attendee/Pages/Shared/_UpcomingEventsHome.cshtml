@model EventListingViewModel

@if(Model.BookedEvents != null){
  <h1 class="text-center">Upcoming</h1>
    <div class="netflix-slider">
          <div class="row d-flex justify-content-center pt-2 pb-6">
          <div class="swiper-container">
            <div class="swiper-wrapper">
            @foreach (var item in Model.BookedEvents)
            {    
                <div class="swiper-slide col-3 p-0 m-4 text-center border event-border ">
                 <a class="text-decoration-none" asp-area="Events" asp-page="/Showroom" asp-route-id="@item.EventId">
                        <div style="background-image: url('data:image/png;base64, @Model.EventImages.Where(x=>x.EventId == item.EventId).SingleOrDefault(x => x.Cover == true).Content')" class="p-5 image-grid-cover">
                          <h5 class="cover-text"> @Html.DisplayFor(m=>item.Name) </h5>
                          <p class="cover-text"> @item.EventDate.ToString("d MMM \\'yy") </p>
                        </div> 
                  </a>
                </div>
            }
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
          </div>
          </div>  
      </div>
}