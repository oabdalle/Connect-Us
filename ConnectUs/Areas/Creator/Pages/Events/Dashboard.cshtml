@page
@model DashboardModel
<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.css" />
<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />

<script src="https://unpkg.com/swiper/swiper-bundle.js"></script>
<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
@{
    ViewData["Title"] = "Dashboard";
}
<h1 class="p-5">@ViewData["Title"]</h1>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.3.1/css/all.min.css" rel="stylesheet">

  <div class="header-body">
      <div class="row justify-content-center"> 
    @foreach (var key in Model.EventsChat.Keys)
    {    
                  <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12 p-3">
                    <a asp-area="Events" asp-page="/Showroom" asp-route-id="@key.EventId" class="card card-stats mb-4 mb-xl-0">
                        <div class="card-body">
                          <div class="row">
                              <div class="col">
                                <h5 class="card-title text-uppercase text-muted mb-0">@Html.DisplayFor(m=>key.EventDate)</h5>
                                <span class="h2 font-weight-bold mb-0">@Html.DisplayFor(m=>key.Name)</span>
                              </div>
                              <div class="col-auto">
                                <div class="icon icon-shape bg-danger text-white rounded-circle shadow">
                                    <i class="fas fa-chart-bar"></i>
                                </div>
                              </div>
                          </div>
                          <p class="mt-3 mb-0 text-muted text-sm">
                              <span class="mr-2"><i class="far fa-comments"></i> @Html.DisplayFor(m=>Model.EventsChat[key].Messages.Count)</span>
                              <span class="text-nowrap">Chat Messages</span>
                          </p>
                          <p class="mt-3 mb-0 text-muted text-sm">
                              <span class="text-success mr-2"><i class="fas fa-plus-square"></i> @Model.EventsChat[key].Messages.Where(m=>m.Text.Contains("Buy")).Count()</span>
                              <span class="text-nowrap">Positive Chat Messages</span>
                          </p>
                          <p class="mt-3 mb-0 text-muted text-sm">
                              <span class="text-danger mr-2"><i class="fas fa-minus-square"></i> @Model.EventsChat[key].Messages.Where(m=>m.Text.Contains("Sell")).Count() </span>
                              <span class="text-nowrap">Negative Chat Messages</span>
                          </p>
                          <p class="mt-3 mb-0 text-muted text-sm">
                              <span class="text-success mr-2"><i class="fas fa-thumbs-up"></i> @Model.LikeTotal</span>
                              <span class="text-nowrap">Total Likes</span>
                          </p>
                        </div>
                    </a>
                  </div>
         
                  
    }

         </div>
    </div>

<div>
  @if(Model.EventsDict.Count()>0){

      foreach(KeyValuePair<string, List<Event>> entry in Model.EventsDict)
      {
          <div class="netflix-slider">
          <h1 class="p-4"> @Html.DisplayFor(m=>entry.Key)</h1>
          <div class="row d-flex justify-content-center pt-2 pb-6">
            <div class="swiper-container">
              <div class="swiper-wrapper">
              @if(entry.Value.Count > 0){
                @foreach (var item in entry.Value)
                { 
                  <div class="swiper-slide col-3 p-0 m-4 text-center border event-border ">
                      <a class="text-decoration-none" asp-area="Events" asp-page="/Showroom" asp-route-id="@item.EventId">
                        <div style="background-image: url('/uploads/@Model.EventImages.Where(x=>x.EventId == item.EventId).SingleOrDefault(x => x.Cover == true).ImagePath')" class="p-5 image-grid-cover">
                          <h5 class="cover-text"> @Html.DisplayFor(m=>item.Name) </h5>
                          <p class="cover-text"> @item.EventDate.ToString("d MMM \\'yy") </p>
                        </div> 
                      </a>
                    </div>
                }
          
              }else{
                <div>
                  <p>No events available.</p>
                </div>
              }
              </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
            </div>
           </div>  
          </div>
      }
  }else{
      <p>No Events available.</p>
  }
</div>

<style>
.icon-shape {
    display: inline-flex;
    padding: 12px;
    text-align: center;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
}
.card-stats{
  text-decoration: none !important;
} 
.icon {
    width: 3rem;
    height: 3rem;
}
</style>