@page
@model EditEvent
@{
    ViewData["Title"] = "Edit Event";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.7.6/dropzone.min.css" integrity="sha512-jU/7UFiaW5UBGODEopEqnbIAHOI8fO6T99m7Tsmqs2gkdujByJfkCbbfPSN4Wlqlb9TGnsuC0YgUgWkRBK7B9A==" crossorigin="anonymous" />

<h1>@ViewData["Title"]</h1>

<div class="edit-images-view"
  <partial name="_EditImages" model="@Model.eventsImages"/>
</div>

<form enctype = "multipart/form-data" method="post" id ="editEventInfo">
    <div>
        <input type="hidden" asp-for="eventEntry.EventId">
        <input type="hidden" asp-for="eventEntry.CategoryId">
        <div class="text-danger" asp-validation-summary="ModelOnly"></div>
        <div>
            <div>
                <label asp-for="eventEntry.Name"></label>
            </div>
            <div>
                <input asp-for="eventEntry.Name"></input>
            </div>
            <span asp-validation-for="eventEntry.Name" class="text-danger"></span>
        </div>
        <div>
            <div>
                <label asp-for="eventEntry.EventDate"></label>
            </div>
            <div>
                <input asp-for="eventEntry.EventDate"></input>
            </div>
            <span asp-validation-for="eventEntry.EventDate" class="text-danger"></span>
        </div>
        <div>
            <div>
                <label asp-for="categoryEntry.CategoryName"></label>
            </div>
            <div>
                <input asp-for="categoryEntry.CategoryName"></input>
            </div>
            <span asp-validation-for="categoryEntry.CategoryName" class="text-danger"></span>
        </div>
         <div>
            <div>
                <label asp-for="eventEntry.Description"></label>
            </div>
            <div>
                <input asp-for="eventEntry.Description"></input>
            </div>
            <span asp-validation-for="eventEntry.Description" class="text-danger"></span>
        </div>
        
        <div class="form-group row" id="addImages" style="display: none;">
            <div class="col-3">
                <label asp-for="eventEntry.GalleryFiles">
                </label>
            </div>
            <div class="col-9">
                <div id="dZUpload" class="border border-primary dropzone dz-clickable rounded">
                    <div class="dz-message">Drop files here or click to upload and rearrange.
                            <br>
                    </div>

                 </div>

            <input hidden type="file" id="imgs" asp-for="eventEntry.GalleryFiles" multiple/>
            <span asp-validation-for="eventEntry.GalleryFiles" class="text-danger"></span>
            </div>
        </div>
        <input id="setup-event" value="Update" class="btn btn-primary w-100"/>
        <input hidden type="submit" id="post-event" />
        <a asp-area="Events" asp-page="/Showroom" asp-route-id="@Model.eventEntry.EventId" class="btn btn-info text-white">Cancel</a>
        
    </div>
</form>
<button id="showDropzone" onclick="showDropzoneInForm()">Add</button>
<button id="hideDropzone"style="display: none;" onclick="showDropzoneInForm()">No Images</button>

@section Scripts{
<script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.7.6/min/dropzone.min.js" integrity="sha512-KgeSi6qqjyihUcmxFn9Cwf8dehAB8FFZyl+2ijFEPyWu4ZM8ZOQ80c2so59rIdkkgsVsuTnlffjfgkiwDThewQ==" crossorigin="anonymous"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js" integrity="sha256-VazP97ZCwtekAsvgPBSUwPFKdrwD3unUfSGVYrahUqU=" crossorigin="anonymous"></script>
  <partial name="_ValidationScriptsPartial"/> 
  <script src="~/js/editImage.js"></script>
   
  </script>
}  