@page
@model EditEvent
@{
    ViewData["Title"] = "Edit Event";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.7.6/dropzone.min.css" integrity="sha512-jU/7UFiaW5UBGODEopEqnbIAHOI8fO6T99m7Tsmqs2gkdujByJfkCbbfPSN4Wlqlb9TGnsuC0YgUgWkRBK7B9A==" crossorigin="anonymous" />

<h1 class="p-5">@ViewData["Title"]</h1>


<div class="form-style-6">
<h1>Edit Your Event!</h1>
<form enctype = "multipart/form-data" method="post" id ="editEventInfo">
    <div class="edit-images-view">
    @if(Model.eventsImages.Count()>0){
        @foreach (var item in Model.eventsImages)
        {
        <div>
        <img class="edit-img"src="/uploads/@item.ImagePath"/>
        @if(Model.eventsImages.Count()>1){
        <button type="submit" asp-page-handler="RemoveImage" asp-route-imageid="@item.ImageId" class="btn btn-danger btn-sm">Remove</button>
        }
        @if(item.Cover != true){
        <button type="submit" asp-page-handler="SetCover" asp-route-imageid="@item.ImageId" class="btn btn-primary btn-sm">Set as Cover</button>      
        }
        </div>
        }
    }  
    </div>
    <div>
        <input type="hidden" asp-for="eventEntry.EventId">
        <input type="hidden" asp-for="eventEntry.HostId">
        <input type="hidden" asp-for="eventEntry.CategoryId">
        <div class="text-danger" asp-validation-summary="ModelOnly"></div>
        <div>
            <div>
                <label asp-for="EventViewModel.Name"></label>
            </div>
            <div>
                <input class="form-input" type="text" asp-for="EventViewModel.Name"></input>
            </div>
            <span asp-validation-for="EventViewModel.Name" class="text-danger"></span>
        </div>
        <div>
            <div>
                <label asp-for="EventViewModel.EventDate"></label>
            </div>
            <div>
                <input class="form-input" type="text" asp-for="EventViewModel.EventDate"></input>
            </div>
            <span asp-validation-for="EventViewModel.EventDate" class="text-danger"></span>
        </div>
        <div>
            <div>
                <label asp-for="categoryEntry.CategoryName"></label>
            </div>
            <div>
                <input class="form-input" type="text" asp-for="categoryEntry.CategoryName"></input>
            </div>
            <span asp-validation-for="categoryEntry.CategoryName" class="text-danger"></span>
        </div>
         <div>
            <div>
                <label asp-for="EventViewModel.Description"></label>
            </div>
            <div>
                <input class="form-input" type="text" asp-for="EventViewModel.Description"></input>
            </div>
            <span asp-validation-for="EventViewModel.Description" class="text-danger"></span>
        </div>
        <input class="mb-1" type="button" id="showDropzone" onclick="showDropzoneInForm()" value="Add Image"/>
        <input class="mb-1" type="button" id="hideDropzone"style="display: none;" onclick="showDropzoneInForm()" value="No Images"/>
        <div class="form-group row" id="addImages" style="display: none;">
            <div class="col-3">
                <label asp-for="EventViewModel.GalleryFiles">
                </label>
            </div>
            <div class="col-9">
                <div id="dZUpload" class="border border-primary dropzone dz-clickable rounded">
                    <div class="dz-message">Drop files here or click to upload and rearrange.
                            <br>
                    </div>

                 </div>

            <input hidden type="file" id="imgs" asp-for="EventViewModel.GalleryFiles" multiple/>
            </div>
        </div>

        <input type="button" id="setup-event" value="Update" class="btn btn-primary w-100"/>
        <input asp-page-handler="AlterEvent" asp-route-id="@Model.eventEntry.EventId" hidden type="submit" id="post-event" />
        <a asp-area="Events" asp-page="/Showroom" asp-route-id="@Model.eventEntry.EventId" class="btn btn-info text-white">Cancel</a>
        
    </div>
</form>

</div>
@section Scripts{
<script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.7.6/min/dropzone.min.js" integrity="sha512-KgeSi6qqjyihUcmxFn9Cwf8dehAB8FFZyl+2ijFEPyWu4ZM8ZOQ80c2so59rIdkkgsVsuTnlffjfgkiwDThewQ==" crossorigin="anonymous"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js" integrity="sha256-VazP97ZCwtekAsvgPBSUwPFKdrwD3unUfSGVYrahUqU=" crossorigin="anonymous"></script>
  <partial name="_ValidationScriptsPartial"/> 
  <script src="~/js/editImage.js"></script>
   
  </script>
}  