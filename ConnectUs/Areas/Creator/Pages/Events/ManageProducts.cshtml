@page
@inject UserManager<IdentityUser> userManager;
@model ManageProducts
@{
    ViewData["Title"] = "Manage Products";
}

<h1 class="p-5">@ViewData["Title"]</h1>
<div class="row justify-content-end">
<button data-toggle="modal" data-id="@Model.eventEntry.EventId" data-target="#productEditModalCenter" class="create-product btn btn-primary mr-5">Create Product</button>
</div>
<partial name="_CreateEditProduct" model="@new Product()"/>

<div class="col-10 col-sm-12 px-5 mt-4">
    <form method="post">
    @if(Model.ProductList != null){
      @if(Model.ProductList.Count()>0){
      <table class="table table-striped custab">
        <tr class="table-active">
          <th>Image</th>
          <th>
            <label asp-for="ProductList.FirstOrDefault().Name"></label>
          </th>
          <th> <label asp-for="ProductList.FirstOrDefault().Price"></label></th>
          <th>Video</th>
          <th></th>
        </tr>
        @foreach (var item in Model.ProductList)
        {
        <tr>
          <td>
            <img src="@item.ImageBase64" style="width: 300px;">
          </td>
          <td>
            @Html.DisplayFor(m=>item.Name)
          </td>
          <td>
            @Html.DisplayFor(m=>item.Price)
          </td>
          <td class="d-flex justify-content-center align-items-center flex-column">
            <div>
              <button type="button" class="btn btn-success btn-sm" data-toggle="modal" data-target="#UploadVideo" data-product=@item.ProductId data-event=@item.EventId>  
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-square" viewBox="0 0 16 16">
                      <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                      <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                    </svg> Add New  
                    </button>   
            </div>  
             <video class="w-50" width="200" height="200" controls muted src="~/uploads/@item.VideoBase64" type="video/mp4"></video>
          </td>
          <td>
            <button asp-page-handler="DeleteProduct" asp-route-id="@item.ProductId" asp-route-eventId="@item.EventId" class="btn btn-danger btn-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-square" viewBox="0 0 16 16">
                <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/>
                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
              </svg>
              Delete</button>
            <button type="button" data-id="@item.ProductId" class="edit-product btn btn-info btn-sm text-white" data-toggle="modal" data-target="#productEditModalCenter">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5v11z"/>
              </svg>
              Edit</button>

          </td>
        </tr>

        }
      </table>
      }else{
      <p>No Products available.</p>
      }
    }
    </form>
  </div>
  <div class="modal fade" id="UploadVideo">  
    <div class="modal-dialog">  
      <div class="modal-content">  
        <div class="modal-header">  
          <h4 class="modal-title">Upload New video File</h4>  
          <button type="button" class="close" data-dismiss="modal">×</button>  
          </div>  
            <div class="modal-body">  
            <form enctype = "multipart/form-data" method="post">
                <div class="form-group">   
                <label>Choose File:</label>  
                  <div class="input-group">  
                    <div class="custom-file">  
                      <input asp-for="UploadModel.fileupload" type="file" class="custom-file-input" />  
                      <label class="custom-file-label"></label>  
                    </div>  
                    <div class="input-group-append"> 
                       <input asp-for="UploadModel.productId" hidden type="number" />
                       <input asp-for="UploadModel.eventId" hidden type="number" />
                       <button asp-page-handler="UploadVideo" class="btn btn-primary btn-sm">Save Video</button>
                  </div>  
                </div> 
            </form> 
            </div>  
            <div class="modal-footer">  
              <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>  
            </div>  
        </div>  
    </div>  
  </div>
  @section Scripts { 
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.7.6/min/dropzone.min.js" integrity="sha512-KgeSi6qqjyihUcmxFn9Cwf8dehAB8FFZyl+2ijFEPyWu4ZM8ZOQ80c2so59rIdkkgsVsuTnlffjfgkiwDThewQ==" crossorigin="anonymous"></script>
  <script src="~/js/editImage.js"></script>
  <script>
            $('#UploadModel_fileupload').on('change',function(){
                //get the file name
                var fileName = $(this).val().split("\\")[2];
                //replace the "Choose a file" label
                $('.custom-file-label').html(fileName);
            })
            $(".popup").click(function(){
              var prodId = $(this).data('product');
              var eventId = $(this).data('event');
              $('#UploadModel_productId').val(prodId);
              $('#UploadModel_eventId').val(eventId);
              //console.log(document.querySelector('#productId').value);
              //console.log(document.querySelector('#eventId').value);
            });
             $(".check").click(function(){
              console.log(document.querySelector('#UploadModel_productId').value);
              console.log(document.querySelector('#UploadModel_eventId').value);
            });
  </script>
}