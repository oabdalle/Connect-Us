  var inputs = $('#productForm :input[type=text]');

  @* var values = {}; *@

  var values = new FormData();
  inputs.each(function() {
      values.append(this.name, $(this).val());
      console.log(values)
      console.log(this.name)
      console.log($(this).val())
  });

  const file = document.querySelector('#imgs').files[0];
 

  if(file != null){
     values.append("ImagePath", file);
  }
  console.log('vcalues ')

  /*const video = document.querySelector('#fileupload').value;
  var fileList = document.querySelector('#fileupload').files[0];
   if(video != null){
     console.log("Hit", fileList);
    values['VideoPath'] = await toPath(fileList);
    values['VideName'] = fileList;
  }*/
  return values;
}

async function EditProduct(){
  var values = await GetFormValues();
  if($("#productForm").valid()){
    
    $.ajax({
          type: "POST",
          @* contentType: "application/json", *@
          url:'/creator/events/manage-products?handler=EditProduct',          
          beforeSend: function (xhr) {
              xhr.setRequestHeader("XSRF-TOKEN",$('input:hidden[name="__RequestVerificationToken"]').val());
          },
          data: values,
          @* dataType: "json", *@
          processData: false,
          contentType: false,
          success: function (result) {
              console.log(result)
              if(result=="Success"){
    
                sessionStorage.setItem('reloadAfterEdit', "true"); 
                window.location.reload(true);     
                    
              }
          },
          failure: function () {
              alert("fail: " );
          },
          error: function (xhr, status, error) {
              alert(xhr.responseText);
          }
      });
  }


}

</script>
<script>
window.addEventListener('load', function () {
   
    $(".edit-product").click(function(){
          var inputs = $('#productForm :input[type=text]');
          inputs.each(function() {
            $(this).val('');
          });
          $('#post-event').unbind('click');
          $('#post-event').click(function(){
            EditProduct();
          });
          var productId = $(this).data('id');

          $.ajax({
          type: "POST",
          url:'/creator/events/manage-products?handler=ProductDetails',          
          beforeSend: function (xhr) {
              xhr.setRequestHeader("XSRF-TOKEN",$('input:hidden[name="__RequestVerificationToken"]').val());
          },
          data: {id: productId},
          success: function (result) {
              console.log(result);
              if(result != null){
                console.log(result.name)
                $('#productName').val(result.name);
                $('#productPrice').val(result.price);
                $('#productId').val(result.productId);
                $('#eventId').val(result.eventId);
              }
          },
          failure: function () {
              alert("fail: ");
          },
          error: function (xhr, status, error) {
              alert(xhr.responseText);
          }
      });
    }); 
    
      $('.create-product').click(function(){
      
        var inputs = $('#productForm :input[type=text]');
        inputs.each(function() {
          $(this).val('');
        });
        var eventId = $(this).data('id');
        $("#eventId").val( eventId );
          $('#post-event').unbind('click');
          $('#post-event').click(function(){
            CreateProduct();
          });
      });

      if (sessionStorage.getItem('reloadAfterEdit')=="true"){
            sessionStorage.setItem('reloadAfterEdit', "false");
            toastr.success("Successful Edit");
      }else if(sessionStorage.getItem('reloadAfterCreate')=="true"){
            sessionStorage.setItem('reloadAfterCreate', "false");
            toastr.success("Successful Create");
      }
})


</script>