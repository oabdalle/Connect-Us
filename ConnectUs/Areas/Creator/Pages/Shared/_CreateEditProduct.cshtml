@model Product

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.7.6/dropzone.min.css" integrity="sha512-jU/7UFiaW5UBGODEopEqnbIAHOI8fO6T99m7Tsmqs2gkdujByJfkCbbfPSN4Wlqlb9TGnsuC0YgUgWkRBK7B9A==" crossorigin="anonymous" />


<div class="modal fade" id="productEditModalCenter" tabindex="-1" role="dialog" aria-labelledby="productEditModalCenterTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="productEditModalLongTitle">Manage Product</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
      <form id="productForm" method="post">
        <input asp-for="ProductId" type="text" readonly hidden id="productId"/>
        <input asp-for="EventId" type="text" readonly hidden id="eventId"/>

        <div class="form-group row">
          <div class="col-6">
            <label asp-for="Name">
            </label> 
          </div>
          <div class="col-6">
            <input asp-for="Name" type="text" id="productName" class="form-control"/>
          </div>
          <span asp-validation-for="Name"  class="text-danger"></span>
        </div>
        <div class="form-group row">
          <div class="col-6">
            <label asp-for="Price">
            </label> 
          </div>
          <div class="col-6">
            <input asp-for="Price" type="text" id="productPrice" class="form-control"/>
          </div>
          <span asp-validation-for="Price" class="text-danger"></span>
        </div>
          
        <div class="form-group row">
          <div class="col-6">
            <label asp-for="ImagePath">
            </label> 
          </div>
          <div class="col-6">
              <div id="dZUpload" class="border border-primary dropzone dz-clickable rounded">
                <div class="dz-message">Drop files here or click to upload and rearrange.
                    <br>
              </div>
              </div>
            <input type="file" id="imgs" />
        </div>

        </div>
    </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        <input id="setup-event" value="Save" class="btn btn-primary"/>
        <input hidden type="submit" id="post-event" />
      </div>
    
    </div>
  </div>
</div>




<script>


async function CreateProduct(){

  var values = await GetFormValues();

  values.set('ProductId', 0);
   for (var key of values.entries()) {
        console.log(key[0] + ', ' + key[1]);
  }
  if($("#productForm").valid()){

    $.ajax({
          type: "POST",
          @* contentType: "application/json", *@
          url:'/creator/events/manage-products?handler=CreateProduct',          
          beforeSend: function (xhr) {
              xhr.setRequestHeader("XSRF-TOKEN",$('input:hidden[name="__RequestVerificationToken"]').val());
          },
          data: values,
          @* dataType: "json", *@
          processData: false,
          contentType: false,
          success: function (result) {
              console.log(result)
              if(result=="Success"){
    
                sessionStorage.setItem('reloadAfterCreate', "true"); 
                window.location.reload(true);     
                    
              }
          },
          failure: function () {
              alert("fail: " );
          },
          error: function (xhr, status, error) {
              alert(xhr.responseText);
          }
      });
  }

}

