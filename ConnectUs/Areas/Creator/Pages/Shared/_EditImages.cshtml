@model List<EventImage> 
@Html.AntiForgeryToken()

 @if(Model.Count()>0){
    @foreach (var item in Model)
    {
    <div class="col-3 p-5 m-3 border">
    <img src="data:image/png;base64, @item.Content"/>
    </div>
    @if(Model.Count()>1){
    <button  onclick="deleteImage(@item.ImageId)">Remove</button>
    }
     @if(item.Cover != true){
    <button onclick="setAsCover(@item.ImageId)">Set as Cover</button>      
    }
    }
  }  
