@page
@model CreateEventModel
@{
    ViewData["Title"] = "Create an Event";
}
<h1>@ViewData["Title"]</h1>
@Html.AntiForgeryToken()
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.7.6/dropzone.min.css" integrity="sha512-jU/7UFiaW5UBGODEopEqnbIAHOI8fO6T99m7Tsmqs2gkdujByJfkCbbfPSN4Wlqlb9TGnsuC0YgUgWkRBK7B9A==" crossorigin="anonymous" />
<form enctype = "multipart/form-data" method="post">
   <div class="text-danger" asp-validation-summary="ModelOnly"></div>
    <div class="form-group row">
      <div class="col-3">
        <label asp-for="Event.Name">
        </label>
      </div>
      <div class="col-6">
        <input asp-for="Event.Name" class="form-control"/>
      </div>
      <span asp-validation-for="Event.Name" class="text-danger"></span>
    </div>

    <div class="form-group row">
      <div class="col-3">
        <label asp-for="Event.EventDate">
        </label>
      </div>
      <div class="col-6">
        <input type="date" asp-for="Event.EventDate" class="form-control"/>
      </div>
      <span asp-validation-for="Event.EventDate" class="text-danger"></span>
    </div>

    <div class="form-group row">
      <div class="col-3">
        <label asp-for="Event.CategoryId">
        </label>
      </div>
      <div class="col-6">
        <select class="form-control text-center" asp-for="Event.CategoryId" asp-items="Model.CategoriesDropDownList">
        <option value=""></option>
        </select>
        </div>
      <span asp-validation-for="Event.CategoryId" class="text-danger"></span>
    </div>

    <div class="form-group row">
      <div class="col-3">
        <label asp-for="Event.Description">
        </label>
      </div>
      <div class="col-6">
        <input asp-for="Event.Description" class="form-control"/>
      </div>
      <span asp-validation-for="Event.Description" class="text-danger"></span>
    </div>

    <div class="form-group row">
      <div class="col-3">
        <label asp-for="Event.GalleryFiles">
        </label>
      </div>
      <div class="col-9">
        <div id="dZUpload" class="border border-primary dropzone dz-clickable rounded">
             <div class="dz-message">Drop files here or click to upload and rearrange.
                    <br>
        
        </div>
        
      </div>
        <input hidden type="file" id="imgs" asp-for="Event.GalleryFiles" multiple/>
        <span asp-validation-for="Event.GalleryFiles" class="text-danger"></span>
    </div>
</div>
    <div class="form-group row">
      <div class="offset-3 col-3">
        <input id="setup-event" value="Create" class="btn btn-primary w-100"/>
        <input hidden type="submit" id="post-event" />
      </div>
      <div class="col-3">  
       <a asp-area="Events" asp-page="Index" class="btn btn-secondary w-100">Back to Events</a>
      </div>
    </div>
</form>


@* this is client side validation not server side (we have done both) *@
@section Scripts{
<script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.7.6/min/dropzone.min.js" integrity="sha512-KgeSi6qqjyihUcmxFn9Cwf8dehAB8FFZyl+2ijFEPyWu4ZM8ZOQ80c2so59rIdkkgsVsuTnlffjfgkiwDThewQ==" crossorigin="anonymous"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js" integrity="sha256-VazP97ZCwtekAsvgPBSUwPFKdrwD3unUfSGVYrahUqU=" crossorigin="anonymous"></script>
  <partial name="_ValidationScriptsPartial"/> 

    <script>

  Dropzone.autoDiscover = false;
  $(document).ready(function () {
      console.log("hello222");
     $("#dZUpload").sortable({
        items:'.dz-preview',
        cursor: 'move',
        opacity: 0.5,
        containment: '#dZUpload',
        distance: 20,
        tolerance: 'pointer'
    });
    $("#dZUpload").dropzone({
        autoProcessQueue: false,
        url: '@Url.Page("CreateEvent", "Upload")',
        addRemoveLinks: true,
      init: function() {
        dzClosure = this;
        this.on("thumbnail", function(file) {
          if (file.width < 300 || file.height < 300) {
              file.rejectDimensions();
              dzClosure.removeFile(file);
          }else if(file.size > 1024*1024){
              file.rejectSize();
              dzClosure.removeFile(file);
          }   
              
          });

      document.getElementById("setup-event").addEventListener("click", async function(e) {
            e.preventDefault();
            e.stopPropagation();
            if(await UpdateFiles(dzClosure.getAcceptedFiles())){
                 console.log("ending with click")
          
                $('#post-event').click();
            }
            
        });
      },
        success: function (file, response) {
        },
        error: function (file, response) {
        },
        accept: function(file, done) {
          file.acceptDimensions = done;
          file.rejectDimensions = function() { alert("Image width or height too big."); };
          file.rejectSize = function() { alert("Image size too big."); };
        }
    });
});
    async function UpdateFiles(dzFiles){
        console.log("here")
        newQueue = [];
        var queue = dzFiles;
        console.log(queue)
        await $('#dZUpload .dz-preview .dz-filename [data-dz-name]').each(async function (count, el) {           
            var name = el.innerHTML;
            await queue.forEach(function(file) {
                if (file.name === name) {
                    newQueue.push(file);
                }
            });
        });
        dzFiles = newQueue;
        console.log(dzFiles)
    
        let list = new DataTransfer();
        for (var i = 0; i < dzFiles.length; i++) {
            list.items.add(dzFiles[i])
        }
        console.log(list);
        let myFileList = list.files;
        console.log(myFileList)
        console.log(document.getElementById('imgs'));
        
        document.getElementById('imgs').files=myFileList; 
          console.log("input before click");
        console.log(document.getElementById('imgs'));
           console.log(document.getElementById('imgs').files);
         console.log("starting to click");
        return true;
    }

    

  </script>
}  