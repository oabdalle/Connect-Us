@page
@model EventDescription
@inject UserManager<IdentityUser> userManager;

@{
    ViewData["Title"] = "Event Description";
}
@Html.AntiForgeryToken()
<h1>@ViewData["Title"]</h1>

<div class="row">
  <div class="col-sm-4 video-display" >
    @if(Model.ProductToDisplay != null){
    <video class="w-100" controls="" muted="" src="../uploads/@Model.ProductToDisplay.VideoBase64" type="video/mp4"></video>
    }else{
    <video class="w-100" muted="" type="video/mp4"></video>
    }
  </div>
  <div class="col-sm-4 product-display">
    @if(Model.ProductToDisplay != null){
      <img class="w-100" src="@Model.ProductToDisplay.ImageBase64">
      <div class="product-name">@Model.ProductToDisplay.Name $@Model.ProductToDisplay.Price</div>
      <a class="btn btn-primary add-to-cart" data-id="@Model.ProductToDisplay.ProductId">Buy</a>
    }else{
      <img class="w-100">
      <div class="product-name"></div>
    }
    
  </div>

</div>
<div class="row">

<form method="post" id ="eventInfo" class="col-sm-4">
    <div>
        <div>
            <label>@Model.eventEntry.Name</label>
        </div>
        <div>
            <label>@Model.eventEntry.EventDate</label>
        </div> 
        <div>
            <label>@Model.categoryEntry.CategoryName</label>
        </div> 
        <div>
            <label>@Model.eventEntry.Description</label>
        </div>  
      @if((Model.eventEntry.HostId == userManager.GetUserId(User)) && (User.Identity.IsAuthenticated && User.IsInRole("Admin") || User.IsInRole("Creator"))){        
          <button asp-page-handler="Delete" asp-route-id="@Model.eventEntry.EventId" onclick="return confirm('Are you sure')" class="btn btn-danger btn-sm">Remove</button>
          <a asp-area="Creator" asp-page="/Events/EditEvent" asp-route-id="@Model.eventEntry.EventId" class="btn btn-sm">Edit</a>
          <a asp-area="Creator" asp-page="/Events/ManageProducts" asp-route-id="@Model.eventEntry.EventId" class="btn btn-success btn-sm">Manage Products</a>
          <a asp-area="Creator" asp-page="/Events/Dashboard" class="btn btn-primary btn-sm">Dashboard</a>


        }else if(User.Identity.IsAuthenticated && User.IsInRole("Attendee")){
          @if(Model.eventBooked==false){
            <button asp-page-handler="BookEvent" asp-route-eventId="@Model.eventEntry.EventId"  asp-route-userId="@userManager.GetUserId(User)" class="btn btn-primary btn-sm">Book Event</button>
          }else{
            <button disabled class="btn btn-primary btn-sm">Event Booked</button>
            <button asp-page-handler="DeleteBooking" asp-route-eventId="@Model.eventEntry.EventId"  asp-route-userId="@userManager.GetUserId(User)" class="btn btn-primary btn-sm">Cancel Booking</button>
          }
        }
        @if(User.Identity.IsAuthenticated && User.IsInRole("Attendee")){
            <a asp-area="Attendee" asp-page="/Index" class="btn btn-sm">Return</a>
        }else{   
            <a asp-area="Events" asp-page="/Index" class="btn btn-sm">Return</a>
        }
    </div>
</form>
@if(Model.ProductList.Count()>0){

  <div class="col-sm-6">
    <h1>Products List</h1>
      <div class="row product-row">
        @foreach (var item in Model.ProductList)
        {
          <div class="col-sm-4 product" data-id="@item.ProductId">
            <img src="@item.ImageBase64" class="w-100">
       
            @Html.DisplayFor(m=>item.Name)
          </div>
          }
      </div>
  </div>   
}
</div>
  @if(Model.Chat != null){
<div class="chat-body">

    @foreach(var message in Model.Chat.Messages){
    <div class="message">
        <header>@message.Name:</header>
        <p>@message.Text</p>
        <footer>@message.Timestamp</footer>
    </div>
    }

</div>

<div class="chat-input">
    <input type="hidden" name="roomId" id="roomId" value="@Model.Chat.ChatId">
    <input type="text" name="message" id="message" class="message-input">
    <button id="buy" class="btn-primary btn">Buy</button>
    <button id="sell" class="btn-danger btn">Sell</button>
    <button id="submitMessage" type="submit">Send</button>
</div>

<button type="button" class="like-button" title="Click to like this post!">
    <i class="fa fa-thumbs-up"></i> Like
    |
    <span class="like-count">@Model.likeCount</span>
</button>
  }else{
    <div>Event has not started. Chat disabled.</div>
  }
@section Scripts{
    <script>
      $(".product-row .product").click(function(){
        $('.product-row .product.checked').not(this).removeClass('checked');
        $(this).toggleClass('checked');
    var productMessage ={
                roomId: $("#roomId").val(),
                productId: $(this).data('id')
              };
        console.log(productMessage)
      $.ajax({
        type: 'POST',
        url: '@Url.Action("SendProduct", "Message")',
        data: JSON.stringify(productMessage),
        dataType: "json",
        contentType:'application/json',
        success: function (result) {

          console.log(result);
          if(result=="Success"){
           
          }else if(result=="Not signed in."){
            alert('Not signed in')
          }else if(result=="No message."){
            alert('No chat message.')
          }
        },
        failure: function () {
          alert("fail: " );
        },
        error: function (xhr, status, error) {
          alert('error'+ xhr.responseText);
        }
      });
    })
    </script>
    <script src="~/js/VenueFilter.js"></script>
    <script src="~/js/messageBuilder.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aspnet-signalr/1.1.4/signalr.min.js" integrity="sha512-hqwtOj6waHZZoLRoJoLn0tq34JS97tR1QmhM69uvyrt3LVBiR1o0xeOVAskjUFL1L1fahQH2W7IdcMaFbqCEaw==" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
      $(document).ready(function () {
        $('.add-to-cart').click(function(event)
            {
              var id =$(this).attr("data-id")
              console.log(id);
              AddToCart(id);
            });

            $('.like-button').click(function(event)
              {
                var like ={
                  roomId: $("#roomId").val(),
                  eventId: @Model.eventEntry.EventId
                };
                SendAjaxLike(like);
              });

            $("#buy").click(function (event) {
              var chatMessage ={
                  roomId: $("#roomId").val(),
                  message: "Buy!"
                };
                SendAjaxMessage(chatMessage);
              });


            $("#sell").click(function (event) {
                  var chatMessage ={
                  roomId: $("#roomId").val(),
                  message: "Sell!"
                };
                SendAjaxMessage(chatMessage);
               });
            $("#submitMessage").click(function (event) {
               
                var chatMessage ={
                  roomId: $("#roomId").val(),
                  message: $("#message").val()
                };

              SendAjaxMessage(chatMessage);
            });                  
        });
        
        function AddToCart(id){
          
          var productDetails ={
            productId: parseInt(id),
            eventId: parseInt(@Model.eventEntry.EventId)
         
          };
          console.log(productDetails);
          console.log('hii')
           console.log(JSON.stringify(productDetails));

          $.ajax({
        
              type: 'POST',
              url: '/api/Cart/Buy',
              data: JSON.stringify(productDetails),
              dataType: "json",
        
              contentType:'application/json',
              success: function (result) {
                if(result=="Success"){
                  console.log(result);
              }
              },
              failure: function () {
                alert("fail: " );
              },
              error: function (xhr, status, error) {
    
                alert('error'+ xhr.responseText);
              }
          });
        }
        function SendAjaxMessage(message){
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("SendMessage", "Message")',
                    data: JSON.stringify(message),
                    dataType: "json",
                    contentType:'application/json',
                    success: function (result) {

                        console.log(result);
                      if(result=="Success"){
                        $("#message").val('');
                      }else if(result=="Not signed in."){
                        alert('Not signed in')
                      }else if(result=="No message."){
                        alert('No chat message.')
                      }
                    },
                    failure: function () {
                      alert("fail: " );
                    },
                    error: function (xhr, status, error) {
                      alert('error'+ xhr.responseText);
                    }
                });
        }
        function SendAjaxLike(likeUpdate){
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("LikeMessageUpdate", "Message")',
                    data: JSON.stringify(likeUpdate),
                    dataType: "json",
                    contentType:'application/json',
                    success: function (result) {

                        console.log(result);
                      if(result=="Success"){
                        $("#message").val('');
                      }else if(result=="Not signed in."){
                        alert('Not signed in')
                      }else if(result=="No message."){
                        alert('No chat message.')
                      }
                    },
                    failure: function () {
                      alert("fail: " );
                    },
                    error: function (xhr, status, error) {
                      alert('error'+ xhr.responseText);
                    }
                });
        }
    function CreateProductDisplay(productId){
      $.ajax({
          type: "POST",
          url:'/events/event-description?handler=DisplayProduct',          
          beforeSend: function (xhr) {
              xhr.setRequestHeader("XSRF-TOKEN",$('input:hidden[name="__RequestVerificationToken"]').val());
          },
          data: {productId: productId},
          success: function (result) {
  
           document.querySelector('.product-display img').src = result.imageBase64;
           document.querySelector('.product-name').innerHTML=result.name + " $"+result.price.toFixed(2);
           var addToCart = document.querySelector('.product-display a.add-to-cart');
           addToCart.setAttribute('data-id', result.productId);
           var video = document.querySelector('.video-display video');
           video.src = "../uploads/"+result.videoBase64;
           video.setAttribute("controls","controls"); 
          },
          failure: function () {
              alert("fail: ");
          },
          error: function () {
              alert("error: ");
          }
      });
    }
    </script>
@if(Model.Chat !=null){
 <script>
    var connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .build();
    var _connectionId = '';
    connection.on("RecieveMessage", function (data) {
      console.log(data);
        var message = messageBuilder()
            .createMessage()
            .withHeader(data.name)
            .withParagraph(data.text)
            .withFooter(data.timestamp)
            .build();
        document.querySelector('.chat-body').append(message);
    })
    connection.on("RecieveLikes", function (data) {
        console.log(data);
        $(".like-count").text(data.totalLikes);
    })
    connection.on("RecieveProductMessage", function (data) {
      console.log(data);
      CreateProductDisplay(data.text);
    })
    connection.start()
        .then(function () {
          connection.invoke('joinRoom', '@Model.Chat.ChatId');
        })
        .catch(function (err) {
            console.log(err)
        })
    window.addEventListener('onunload', function () {
        connection.invoke('leaveRoom', '@Model.Chat.ChatId');
    })
</script>
}
}
 @* data-request-url="@Url.Action("Action", "Controller")" *@