@model EventDescriptionViewModel
@inject UserManager<IdentityUser> userManager;
<style>

  .carousel-item img{
    object-fit: contain;
    height: 400px;
  }
</style>
<div class="event-details justify-content-between no-gutters row p-5">

  <div class="col-sm-5 col-xs-12 d-flex flex-column"> 
    <h1>@Model.Event.Name</h1>
    <h4>@Model.Event.EventDate | @Model.Category.CategoryName </h4>
    <p>@Model.Event.Description</p>
  </div>
  <div class="col-sm-7 col-xs-12 d-flex align-items-center justify-content-center">
  <form method="post" id ="eventInfo">
    <div class="btn-group" role="group" aria-label="Basic example">
      @if((Model.Event.HostId == userManager.GetUserId(User)) && (User.Identity.IsAuthenticated && User.IsInRole("Admin") || User.IsInRole("Creator"))){     
          <a asp-area="Creator" asp-page="/Events/ManageProducts" asp-route-id="@Model.Event.EventId" class="btn btn-success btn-sm">Manage Products</a>
          <a asp-area="Creator" asp-page="/Events/Dashboard" class="btn btn-primary btn-sm">Dashboard</a>   
          
          <a asp-area="Creator" asp-page="/Events/EditEvent" asp-route-id="@Model.Event.EventId" class="btn btn-sm btn-info">Edit</a>
          <button asp-page-handler="Delete" asp-route-id="@Model.Event.EventId" onclick="return confirm('Are you sure')" class="btn btn-danger btn-sm">Remove</button>

        }else if(User.Identity.IsAuthenticated && User.IsInRole("Attendee")){
          @if(Model.EventBooked==false){
            <button asp-page-handler="BookEvent" asp-route-eventId="@Model.Event.EventId"  asp-route-userId="@userManager.GetUserId(User)" class="btn btn-info btn-sm">Book Event</button>
          }else{
            <button asp-page-handler="DeleteBooking" asp-route-eventId="@Model.Event.EventId"  asp-route-userId="@userManager.GetUserId(User)" class="btn btn-warning btn-sm">Cancel Booking</button>
          }
        }
        <a asp-area="Events" asp-page="/Checkout"  type="button" class="btn btn-sm btn-dark">Checkout</a>
        @if(User.Identity.IsAuthenticated && User.IsInRole("Attendee")){
            <a asp-area="Attendee" asp-page="/Index" class="btn btn-sm btn-secondary">Return</a>
        }else{   
            <a asp-area="Events" asp-page="/Index" class="btn btn-sm btn-secondary">Return</a>
        }
    </div>
  </form>
  </div>
</div>

@if(Model.Event.EventDate.Date != DateTime.Today){
  <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
    <ol class="carousel-indicators">
    @foreach(var image in Model.EventImages){
      @if(@Model.EventImages.IndexOf(image)==0){
        <li data-target="#carouselExampleIndicators" data-slide-to="@Model.EventImages.IndexOf(image)" class="active"></li>
      }else{
        <li data-target="#carouselExampleIndicators" data-slide-to="@Model.EventImages.IndexOf(image)"></li>
      }
    }
    </ol>
    <div class="carousel-inner">
    @foreach(var image in Model.EventImages){
      @if(@Model.EventImages.IndexOf(image)==0){
      <div class="carousel-item active">
        <img class="d-block w-100" src="/uploads/@image.ImagePath" alt="@Model.EventImages.IndexOf(image) slide">
      </div>
      }else{
      <div class="carousel-item">
        <img class="d-block w-100" src="/uploads/@image.ImagePath" alt="@Model.EventImages.IndexOf(image) slide">
      </div>
      }
    }
    </div>

    <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="sr-only">Previous</span>
    </a>
    <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="sr-only">Next</span>
    </a>
  </div>
}
