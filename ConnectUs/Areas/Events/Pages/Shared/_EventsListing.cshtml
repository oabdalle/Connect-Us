<link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.5.0/css/font-awesome.min.css" rel="stylesheet" />

@model EventListingViewModel
@inject UserManager<IdentityUser> userManager;
  @{
    var user = new IdentityUser {Id = "" };
  }
  @if(User.Identity.IsAuthenticated){
     user=await userManager.FindByNameAsync(User.Identity.Name);
  }

<div class="w-100 my-5">
  @if(Model.Events.Count()>0){
     @if(Model.BookedEvents != null){
        <h1 class="text-center">Upcoming</h1>
        <div class="row d-flex justify-content-center py-5">
          @foreach (var item in Model.BookedEvents)
          {    
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-12 p-5 m-3 border">
              <a asp-area="Events" asp-page="/EventDescription" asp-route-id="@item.EventId">
              <img style="width: 100px; height: 100px;" src="data:image/png;base64, @Model.EventImages.Where(x=>x.EventId == item.EventId).SingleOrDefault(x => x.Cover == true).Content"/>

              </a>
                  @Html.DisplayFor(m=>item.Name)
              
                  @Html.DisplayFor(m=>item.EventDate)
                
                  @Html.DisplayFor(m=>item.Category.CategoryName)
              
            </div>
          }
        </div>
      }
     }
     @if(Model.Categories.Count()>0){
      @foreach (var category in Model.Categories){

        <h1 class="text-center">@Html.DisplayFor(c=>category.CategoryName)</h1>
        <div class="row d-flex justify-content-center py-5">
         
          @foreach (var item in Model.Events.Where(x => x.CategoryId == (category.CategoryId)))
          {    
             
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-12 p-5 m-3 border">
              @if(user.Id != ""){
              @if(item.HostId == user.Id){<div class="featured fa fa-star"></div>}}
              <a asp-area="Events" asp-page="/EventDescription" asp-route-id="@item.EventId">
              <img style="width: 100px; height: 100px;" src="data:image/png;base64, @Model.EventImages.Where(x=>x.EventId == item.EventId).SingleOrDefault(x => x.Cover == true).Content"/>

              </a>
                  @Html.DisplayFor(m=>item.Name)
              
                  @Html.DisplayFor(m=>item.EventDate)
                
                  @Html.DisplayFor(m=>item.Category.CategoryName)
              
            </div>
          }
        </div>
      }
    }else{
        <p>No Categories available.</p>
    }
  }else{
      <p>No Events available.</p>
  }
</div>
