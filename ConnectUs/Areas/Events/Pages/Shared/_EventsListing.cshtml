<link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.5.0/css/font-awesome.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.css" />
<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />

<script src="https://unpkg.com/swiper/swiper-bundle.js"></script>
<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
@model EventListingViewModel
@inject UserManager<IdentityUser> userManager;

<div>
  <h1 class="text-center pt-4">Events</h1>
</div>
<div>
  @if(Model.Events.Count()>0){
    @if(Model.Categories.Count()>0){
      @foreach (var category in Model.Categories){
        @if(Model.Events.Any(x => x.CategoryId == (category.CategoryId))){
        <div class="netflix-slider">
          <h2>@Html.DisplayFor(c=>category.CategoryName)</h2>
          <div class="row d-flex justify-content-center pt-2 pb-6">
          <div class="swiper-container">
            <div class="swiper-wrapper">
              @foreach (var item in Model.Events.Where(x => x.CategoryId == (category.CategoryId)))
                  {    
                    
                    <div class="swiper-slide col-xl-1 p-5 m-4 text-center border event-border">
                      @if(userManager.GetUserId(User)!= ""){
                      @if(item.HostId == userManager.GetUserId(User)){<div class="featured fa fa-star"></div>}}
                      <a class="text-decoration-none"asp-area="Events" asp-page="/EventDescription" asp-route-id="@item.EventId">
                        <img class="event-image" src="data:image/png;base64, @Model.EventImages.Where(x=>x.EventId == item.EventId).SingleOrDefault(x => x.Cover == true).Content"/>
                        <div class="event-date">
                          <h5 class="with-eight"> @Html.DisplayFor(m=>item.Name) </h5>
                          <p class="font-weight-bold with-eight"> @Html.DisplayFor(m=>item.EventDate) </p>
                        </div> 
                      </a>
                    </div>

                  }
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
          </div>
          </div>  
        </div>
          }
        }
      }else{
            <p>No Categories available.</p>
          }
      }else{
        <p>No Events available.</p>
    }
</div>
  <!-- Initialize Swiper -->
  <script>
    var swiper = new Swiper('.swiper-container', {
      slidesPerView: 6,
      spaceBetween: 10,
      slidesPerGroup: 2,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });
  </script>
