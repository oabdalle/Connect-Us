<link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.5.0/css/font-awesome.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.css" />
<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />

<script src="https://unpkg.com/swiper/swiper-bundle.js"></script>
<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
@model EventListingViewModel
@inject UserManager<IdentityUser> userManager;

<div>
  <h1 class="text-center pt-4">Events</h1>
</div>
<div>
  @if(Model.Events.Count()>0){
    @if(Model.Categories.Count()>0){
      @foreach (var category in Model.Categories){
        @if(Model.Events.Any(x => x.CategoryId == (category.CategoryId))){
        <div class="netflix-slider">
          <h2 class="p-4">@Html.DisplayFor(c=>category.CategoryName)</h2>
          <div class="row d-flex justify-content-center pt-2 pb-6">
          <div class="swiper-container">
            <div class="swiper-wrapper">
              @foreach (var item in Model.Events.Where(x => x.CategoryId == (category.CategoryId)))
                  {    
                    
                    <div class="swiper-slide col-3 p-0 m-4 text-center border event-border ">
                      @if(userManager.GetUserId(User)!= ""){
                      @if(item.HostId == userManager.GetUserId(User)){<div class="featured fa fa-star"></div>}}
                      <a class="text-decoration-none" asp-area="Events" asp-page="/Showroom" asp-route-id="@item.EventId">
                        <div style="background-image: url('/uploads/@Model.EventImages.Where(x=>x.EventId == item.EventId).SingleOrDefault(x => x.Cover == true).ImagePath')" class="p-5 image-grid-cover">
                          <h5 class="cover-text"> @Html.DisplayFor(m=>item.Name) </h5>
                          <p class="cover-text"> @item.EventDate.ToString("d MMM \\'yy") </p>
                        </div> 
                      </a>
                    </div>
                  }
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
          </div>
          </div>  
        </div>
          }
        }
      }else{
            <p>No Categories available.</p>
          }
      }else{
        <p>No Events available.</p>
    }
</div>
<style>
  .image-grid-cover {
    width: 100%;
    background-size: cover;
    height: 100%;
    position: relative;
    text-shadow: rgba(0,0,0,.8) 0 1px 0;
    border-radius: 4px;
}
.cover-text {
    font-size: 25px;
    text-align: center;
    display: block;
    color: #fff !important;
    text-shadow: rgba(0,0,0,.8) 0 1px 0;
    z-index: 21;
    position: relative;
}
a, a:focus, a:hover {
    text-decoration: none;
    outline: 0;
}
</style>
  <!-- Initialize Swiper -->
  <script>
    var swiper = new Swiper('.swiper-container', {
      slidesPerView: 3,
      spaceBetween: 10,
      slidesPerGroup: 2,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });
  </script>
