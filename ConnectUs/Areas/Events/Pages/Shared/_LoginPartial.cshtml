@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager


@if (SignInManager.IsSignedIn(User))
{  <ul class="navbar-nav pr-3">
    <li class="nav-item">
        <a  class="nav-link " asp-area="Account" asp-page="/Manage/Index" title="Manage">Hello @User.Identity.Name!</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Account" asp-page="/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post" >
            <button  type="submit" class="nav-link btn btn-link ">Logout</button>
        </form>
    </li>
    </ul>
}
else
{
  <ul class="navbar-nav pr-3">
    <li class="nav-item">
        <a class="nav-link" asp-area="Account" asp-page="/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="Account" asp-page="/Login">Login</a>
    </li>
    </ul>
}

