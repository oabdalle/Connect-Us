@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
  <a asp-area="Events" asp-page="/Create" class="col-4 btn btn-info text-white">Create New Event</a>
</div>

<div class="col-12 p-3 mt-5">

<div class="row">

  @if(Model.Events.Count()>0){
    @foreach (var item in Model.Events)
    {
    
    <div class="col-3 p-5 m-3 border">
  
        @Html.DisplayFor(m=>item.Name)
    
        @Html.DisplayFor(m=>item.EventDate)

       
        @Html.DisplayFor(m=>item.Category)
    
    </div>
    }
  }else{
      <p>No Events available.</p>
      }
</div>
</div>